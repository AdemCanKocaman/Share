{% extends 'base.html.twig' %}

{% block title %}Liste des fichiers{% endblock %}

{% block body %}
    <h1>Liste des fichiers</h1>
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nom Original</th>
                <th>Date Envoi</th>
                <th>Extension</th>
                <th>Taille (octets)</th>
                <th>Utilisateur</th>
            </tr>
        </thead>
        <tbody>
            {% for fichier in fichiers %}
                <tr>
                    <td>{{ fichier.id }}</td>
                    <td>{{ fichier.nomOriginal }}</td>
                    <td>{{ fichier.dateEnvoi|date('d/m/Y H:i') }}</td>
                    <td>{{ fichier.extension }}</td>
                    <td>{{ fichier.taille }}</td>
                    <td>{{ fichier.user.nom }} {{ fichier.user.prenom }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}